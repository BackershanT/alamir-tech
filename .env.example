# ==============================================================================
# Base Environment Configuration Template
# Project: alamir-tech (Next.js 16 + React 19 + TypeScript + Tailwind CSS)
# ==============================================================================
# INSTRUCTIONS:
# 1. Do NOT commit real secrets or credentials into Git.
# 2. Copy this file to .env.local for local development overrides.
# 3. For environment-specific values, refer to:
#    - .env.development.example
#    - .env.staging.example
#    - .env.production.example
# ==============================================================================

# Node Environment
NODE_ENV=development
APP_ENV=development

# Application Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Backend / Supabase Configuration
# IMPORTANT: ONLY expose the public ANON key with NEXT_PUBLIC_ prefix.
# NEVER expose the SERVICE_ROLE_KEY to frontend code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct Database Connection (Server-Side / Migrations only)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Authentication Secrets
AUTH_SECRET=generate-a-secure-32-byte-hex-or-base64-secret
NEXTAUTH_URL=http://localhost:3000

# Cloud Storage Configuration
NEXT_PUBLIC_STORAGE_BUCKET=company-storage-dev

# Telemetry & Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
