# ==============================================================================
# Development Environment Configuration
# Target Branch: dev
# ==============================================================================

NODE_ENV=development
APP_ENV=development

# Development URLs
NEXT_PUBLIC_APP_URL=https://dev.alamirtech.com
NEXT_PUBLIC_API_URL=https://dev-api.alamirtech.com/api

# Development Backend / Supabase (Isolated Dev Project)
NEXT_PUBLIC_SUPABASE_URL=https://dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key-placeholder

# Development Database Connection
DATABASE_URL=postgresql://postgres.dev-ref:your-dev-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.dev-ref:your-dev-password@aws-0-region.pooler.supabase.com:5432/postgres

# Authentication
AUTH_SECRET=development-auth-secret-min-32-chars-long
NEXTAUTH_URL=https://dev.alamirtech.com

# Storage
NEXT_PUBLIC_STORAGE_BUCKET=alamir-storage-dev

# Telemetry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
