# ==============================================================================
# Staging / QA Environment Configuration
# Target Branch: beta
# ==============================================================================

NODE_ENV=production
APP_ENV=staging

# Staging URLs
NEXT_PUBLIC_APP_URL=https://beta.alamirtech.com
NEXT_PUBLIC_API_URL=https://beta-api.alamirtech.com/api

# Staging Backend / Supabase (Isolated Staging Project)
NEXT_PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-placeholder

# Staging Database Connection
DATABASE_URL=postgresql://postgres.staging-ref:your-staging-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.staging-ref:your-staging-password@aws-0-region.pooler.supabase.com:5432/postgres

# Authentication
AUTH_SECRET=staging-auth-secret-min-32-chars-long
NEXTAUTH_URL=https://beta.alamirtech.com

# Storage
NEXT_PUBLIC_STORAGE_BUCKET=alamir-storage-staging

# Telemetry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
