# ==============================================================================
# Production Environment Configuration
# Target Branch: master
# ==============================================================================
# CAUTION: Never use development or staging credentials here!
# Ensure all secrets are high-entropy, rotated regularly, and stored securely
# in GitHub Secrets (Production Environment) or your hosting provider dashboard.
# ==============================================================================

NODE_ENV=production
APP_ENV=production

# Production URLs
NEXT_PUBLIC_APP_URL=https://alamirtech.com
NEXT_PUBLIC_API_URL=https://api.alamirtech.com/api

# Production Backend / Supabase (Dedicated Production Project)
NEXT_PUBLIC_SUPABASE_URL=https://prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key-placeholder

# Production Database Connection (SSL & Pooling required)
DATABASE_URL=postgresql://postgres.prod-ref:your-prod-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.prod-ref:your-prod-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Authentication
AUTH_SECRET=production-high-entropy-auth-secret-min-32-chars
NEXTAUTH_URL=https://alamirtech.com

# Storage
NEXT_PUBLIC_STORAGE_BUCKET=alamir-storage-production

# Telemetry
NEXT_PUBLIC_SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
